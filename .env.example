# Скопируй этот файл рядом и назови просто .env (без .example),
# затем подставь свои значения. Файл .env в git не попадёт — он в .gitignore.

# Токен бота от @BotFather, выглядит примерно так:
TG_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Твой личный chat_id — куда бот будет слать вакансии.
# Как узнать: напиши своему боту /start, потом запусти
#   python main.py --chatid
TG_CHAT_ID=123456789

# Токен приложения hh.ru — необязательно.
# Без него hh просто выключится, телеграм продолжит работать.
HH_TOKEN=
